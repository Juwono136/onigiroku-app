{
  "name": "onigiroku-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "preflight": "node ./scripts/preflight.mjs",
    "dev": "node ./scripts/preflight.mjs && next dev --webpack",
    "dev:web": "node ./scripts/preflight.mjs && next dev --webpack",
    "dev:turbo": "node ./scripts/preflight.mjs && next dev --turbopack",
    "dev:api": "node ./scripts/dev-api.mjs",
    "dev:all": "concurrently -k -n web,api -c red,cyan \"npm:dev:web\" \"npm:dev:api\"",
    "build": "node ./scripts/preflight.mjs && next build",
    "build:api": "cd backend && go build -o bin/api ./cmd/api",
    "build:all": "npm run build && npm run build:api",
    "start": "next start",
    "start:api": "cd backend && go run ./cmd/api",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "api:tidy": "cd backend && go mod tidy",
    "api:test": "cd backend && go test ./..."
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/noto-sans-jp": "^5.3.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-query": "^5.104.0",
    "@tiptap/extension-blockquote": "^3.31.4",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/extension-table-cell": "^3.31.4",
    "@tiptap/extension-table-header": "^3.31.4",
    "@tiptap/extension-table-row": "^3.31.4",
    "@tiptap/extension-text-align": "^3.31.4",
    "@tiptap/extension-underline": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "better-auth": "^1.7.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "framer-motion": "^13.4.4",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "next-intl": "^4.14.7",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.0.12",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/ioredis": "^4.28.10",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.4",
    "dotenv": "^18.0.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
