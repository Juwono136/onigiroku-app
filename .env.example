# MAIN CONFIG
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:8080"
API_PORT="8080"
CORS_ORIGINS="http://localhost:3000"
APP_URL="http://localhost:3000"
# Optional: force first-visit locale in local/dev (id | en). Leave empty for region/Accept-Language.
# LOCALE_REGION_OVERRIDE=""

# Database Config
DATABASE_URL="postgres://postgres:<password>@localhost:5432/onigiroku_db"
# Optional pool tuning (Next.js postgres.js + Go pgx)
DATABASE_POOL_MAX="10"
DATABASE_POOL_MIN="1"
DATABASE_POOL_IDLE_TIMEOUT_SEC="20"

# Redis Config — ALWAYS include password in URL
# Format: redis://:<redis_password>@localhost:6379
# Production remote Redis should prefer rediss:// (TLS)
REDIS_URL="redis://:<redis_password>@localhost:6379"

# Better-Auth Config
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET="replace_with_openssl_rand_base64_32_chars_min"
BETTER_AUTH_URL="http://localhost:3000"
AUTH_LOCKOUT_ENABLED="true"
AUTH_LOCKOUT_MAX_ATTEMPTS="5"
AUTH_LOCKOUT_WINDOW_SECONDS="900"
AUTH_LOCKOUT_DURATION_SECONDS="1800"
SELF_REGISTRATION_ENABLED="true"
NEXT_PUBLIC_SELF_REGISTRATION_ENABLED="true"
BETTER_AUTH_SESSION_COOKIE="better-auth.session_token"

# Google OAuth (optional locally; required in production if Google sign-in is enabled)
# Setup guide (free Cloud Console): docs/AUTH.md § Setup Google OAuth
# Redirect URI must be: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# AUTH_TRUSTED_ORIGINS="http://localhost:3000,https://onigiroku.com"

# Nodemailer Config (SMTP Server)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="dev@example.com"
SMTP_PASS="replace_me"
SMTP_FROM="noreply@onigiroku.com"
SMTP_REPLY_TO="dev@example.com"
SMTP_FROM_NAME="Onigiroku"
EMAIL_LOGO_URL="https://res.cloudinary.com/dz8dtz5ki/image/upload/v1790609932/logo_ozcqba.png"
SALES_NOTIFY_EMAIL="dev@example.com"

# Object Storage (SeaweedFS)
# Production: STORAGE_ALLOW_LOCALHOST="false"
STORAGE_ALLOW_LOCALHOST="true"
STORAGE_AUTH_MODE="nginx-basic"
STORAGE_ENDPOINT="http://localhost:8333"
NEXT_PUBLIC_STORAGE_URL="http://localhost:8333"
STORAGE_BUCKET="onigiroku"
STORAGE_REGION="us-east-1"
USERNAME_STORAGE="admin"
PASSWORD_STORAGE="<storage_password>"

# Logging (optional: debug | info | warn | error)
# Production: prefer info or warn (never debug)
LOG_LEVEL="debug"

# Protect /api/health and Go /ready in production (min 16 chars)
HEALTH_CHECK_TOKEN="<health_token>"

# Go Backend
# Production: GIN_MODE="release"
GIN_MODE="debug"
API_READ_TIMEOUT="15s"
API_WRITE_TIMEOUT="30s"
API_IDLE_TIMEOUT="60s"
API_RATE_LIMIT_MAX="300"
API_AUTH_RATE_LIMIT_MAX="120"
# Shared secret Next.js → Go for mutating /api/v1 routes (min 16 chars)
INTERNAL_API_SECRET="replace_with_long_random_secret"

# Optional: Xendit token checkout
XENDIT_SECRET_KEY="xnd_development_xxx"
XENDIT_CALLBACK_TOKEN="<xendit_callback_token>"
XENDIT_PUBLIC_KEY="xnd_public_development_xxx"
